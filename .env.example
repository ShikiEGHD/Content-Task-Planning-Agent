# 环境变量设计草案；当前尚无读取这些变量的程序。
# 不填入真实密钥；复制为 .env 后仅在本地填写。
# mode: mock 或 cloud，最终参数与优先级在实现时确定。
AGENT_MODE=mock

# 云端供应商、模型名称、认证与 endpoint 均待选型。
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=

# 下面为待确认的建议上限，不代表当前已生效。
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=10

# 实现完成后同步更新 README 和本文件；离线 mock 不得要求密钥。
